<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>Бетельгейзе — Красный Сверхгигант</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    overscroll-behavior: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  body {
    font-family: 'Segoe UI', Tahoma, sans-serif;
    background: #000;
    color: #f5e6c8;
    overflow: hidden;
    height: 100vh;
    height: 100dvh;
    touch-action: none;
    position: fixed;
    width: 100%;
  }
  #canvas-container {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 1;
    touch-action: none;
  }
  .slide {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 2;
    padding: 60px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s ease;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .slide.active { opacity: 1; pointer-events: auto; }
  .slide.left-align { align-items: flex-start; max-width: 55%; }
  .slide.right-align { align-items: flex-end; text-align: right; }
  .slide.center-align { align-items: center; text-align: center; }

  h1 {
    font-size: 5em;
    font-weight: 200;
    letter-spacing: 0.15em;
    margin-bottom: 20px;
    background: linear-gradient(90deg, #ff6b35, #ffaa5e, #ff4500);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 60px rgba(255,100,50,0.3);
  }
  h2 {
    font-size: 2.8em;
    font-weight: 300;
    margin-bottom: 30px;
    color: #ffb366;
    letter-spacing: 0.05em;
  }
  h3 {
    font-size: 1.5em;
    color: #ff8c42;
    margin: 20px 0 10px;
    font-weight: 400;
  }
  p, li {
    font-size: 1.25em;
    line-height: 1.7;
    margin-bottom: 12px;
    color: #f0e0c0;
  }
  ul { list-style: none; padding-left: 0; }
  ul li::before {
    content: "◉ ";
    color: #ff6b35;
    font-size: 0.8em;
  }
  .subtitle {
    font-size: 1.8em;
    color: #ffaa5e;
    font-style: italic;
    margin-bottom: 30px;
    letter-spacing: 0.1em;
  }
  .tag {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(255,100,50,0.15);
    border: 1px solid rgba(255,100,50,0.4);
    border-radius: 20px;
    margin: 5px;
    font-size: 0.95em;
    color: #ffaa5e;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
    width: 100%;
    max-width: 700px;
  }
  .stat-box {
    background: rgba(255,100,50,0.08);
    border-left: 3px solid #ff6b35;
    padding: 15px 20px;
    backdrop-filter: blur(10px);
  }
  .stat-value {
    font-size: 2em;
    color: #ffb366;
    font-weight: 300;
  }
  .stat-label {
    font-size: 0.9em;
    color: #c0a080;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Навигация */
  .nav {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 15px;
    align-items: center;
  }
  .nav-btn {
    background: rgba(255,100,50,0.2);
    border: 1px solid rgba(255,100,50,0.5);
    color: #ffaa5e;
    padding: 12px 24px;
    cursor: pointer;
    border-radius: 25px;
    font-size: 1em;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
    min-width: 44px;
    min-height: 44px;
    touch-action: manipulation;
  }
  .nav-btn:hover, .nav-btn:active {
    background: rgba(255,100,50,0.4);
    transform: translateY(-2px);
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: rgba(255,100,50,0.3);
    cursor: pointer;
    transition: all 0.3s;
    touch-action: manipulation;
  }
  .dot.active {
    background: #ff6b35;
    box-shadow: 0 0 10px #ff6b35;
    transform: scale(1.3);
  }
  .slide-counter {
    position: fixed;
    top: 30px;
    right: 40px;
    z-index: 10;
    color: #ffaa5e;
    font-size: 1em;
    letter-spacing: 0.2em;
  }
  .title-logo {
    position: fixed;
    top: 30px;
    left: 40px;
    z-index: 10;
    color: #ff6b35;
    font-size: 1.2em;
    letter-spacing: 0.3em;
    font-weight: 200;
  }
  .highlight { color: #ff6b35; font-weight: 500; }
  .quote {
    font-style: italic;
    border-left: 2px solid #ff6b35;
    padding-left: 20px;
    margin: 20px 0;
    color: #ffcc99;
  }
  .timeline { margin-top: 20px; }
  .timeline-item {
    padding: 10px 0 10px 25px;
    border-left: 2px solid rgba(255,100,50,0.4);
    position: relative;
    margin-bottom: 10px;
  }
  .timeline-item::before {
    content: "";
    position: absolute;
    left: -6px; top: 15px;
    width: 10px; height: 10px;
    background: #ff6b35;
    border-radius: 50%;
    box-shadow: 0 0 10px #ff6b35;
  }
  .timeline-date {
    color: #ff8c42;
    font-weight: 500;
    font-size: 1em;
  }
  .timeline-text {
    color: #f0e0c0;
    font-size: 1.05em;
  }

  /* Подсказка по свайпу */
  .swipe-hint {
    position: fixed;
    bottom: 100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    color: rgba(255,170,94,0.7);
    font-size: 0.9em;
    letter-spacing: 0.1em;
    text-align: center;
    opacity: 0;
    animation: hintFade 4s ease-in-out 1s forwards;
    pointer-events: none;
  }
  @keyframes hintFade {
    0% { opacity: 0; transform: translateX(-50%) translateY(10px); }
    20% { opacity: 1; transform: translateX(-50%) translateY(0); }
    80% { opacity: 1; transform: translateX(-50%) translateY(0); }
    100% { opacity: 0; transform: translateX(-50%) translateY(-10px); }
  }

  /* ===== МОБИЛЬНАЯ АДАПТАЦИЯ ===== */
  @media (max-width: 768px) {
    .slide { padding: 80px 25px 120px; }
    .slide.left-align, .slide.right-align { 
      max-width: 100%; 
      align-items: flex-start; 
      text-align: left; 
    }
    h1 { font-size: 2.8em; letter-spacing: 0.1em; margin-bottom: 15px; }
    h2 { font-size: 1.8em; margin-bottom: 20px; }
    h3 { font-size: 1.2em; margin: 15px 0 8px; }
    p, li { font-size: 1em; line-height: 1.6; margin-bottom: 8px; }
    .subtitle { font-size: 1.2em; margin-bottom: 20px; }
    .tag { padding: 5px 12px; font-size: 0.85em; margin: 3px; }
    
    .stats { grid-template-columns: 1fr; gap: 12px; }
    .stat-box { padding: 12px 15px; }
    .stat-value { font-size: 1.5em; }
    .stat-label { font-size: 0.8em; }
    
    .title-logo { top: 15px; left: 20px; font-size: 0.9em; letter-spacing: 0.2em; }
    .slide-counter { top: 15px; right: 20px; font-size: 0.85em; }
    
    .nav { 
      bottom: 15px; 
      gap: 10px;
      width: calc(100% - 30px);
      justify-content: space-between;
    }
    .nav-btn { 
      padding: 10px 16px; 
      font-size: 0.9em;
      flex: 1;
    }
    .dots { gap: 6px; }
    .dot { width: 10px; height: 10px; }
    
    .quote { padding-left: 15px; font-size: 0.95em; }
    .timeline-item { padding-left: 20px; }
    .timeline-date { font-size: 0.9em; }
    .timeline-text { font-size: 0.95em; }
  }

  @media (max-width: 380px) {
    .slide { padding: 70px 18px 110px; }
    h1 { font-size: 2.2em; }
    h2 { font-size: 1.5em; }
    p, li { font-size: 0.95em; }
    .nav-btn { padding: 8px 12px; font-size: 0.85em; }
  }

  /* Альбомная ориентация на телефоне */
  @media (max-height: 500px) and (orientation: landscape) {
    .slide { padding: 20px 40px 80px; }
    h1 { font-size: 2.5em; margin-bottom: 10px; }
    h2 { font-size: 1.6em; margin-bottom: 15px; }
    p, li { font-size: 0.95em; margin-bottom: 6px; }
    .subtitle { margin-bottom: 15px; font-size: 1.1em; }
    .stats { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .timeline-item { margin-bottom: 5px; padding: 5px 0 5px 20px; }
  }
</style>
</head>

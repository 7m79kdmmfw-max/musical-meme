<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ============ 3D СЦЕНА ============
const container = document.getElementById('canvas-container');
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(60, window.innerWidth/window.innerHeight, 0.1, 2000);
camera.position.z = 5;

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
container.appendChild(renderer.domElement);

// Фоновые звёзды
const starsGeometry = new THREE.BufferGeometry();
const starsCount = window.innerWidth < 768 ? 1500 : 3000;
const starsPositions = new Float32Array(starsCount * 3);
const starsSizes = new Float32Array(starsCount);
for (let i = 0; i < starsCount; i++) {
  starsPositions[i*3]   = (Math.random() - 0.5) * 1500;
  starsPositions[i*3+1] = (Math.random() - 0.5) * 1500;
  starsPositions[i*3+2] = (Math.random() - 0.5) * 1500;
  starsSizes[i] = Math.random() * 2;
}
starsGeometry.setAttribute('position', new THREE.BufferAttribute(starsPositions, 3));
starsGeometry.setAttribute('size', new THREE.BufferAttribute(starsSizes, 1));

const starsMaterial = new THREE.ShaderMaterial({
  uniforms: { time: { value: 0 } },
  vertexShader: `
    attribute float size;
    varying float vSize;
    void main() {
      vSize = size;
      vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
      gl_PointSize = size * (200.0 / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
    }
  `,
  fragmentShader: `
    varying float vSize;
    void main() {
      float d = length(gl_PointCoord - vec2(0.5));
      if (d > 0.5) discard;
      float alpha = smoothstep(0.5, 0.0, d);
      gl_FragColor = vec4(1.0, 0.95, 0.85, alpha);
    }
  `,
  transparent: true,
  depthWrite: false
});
const stars = new THREE.Points(starsGeometry, starsMaterial);
scene.add(stars);

// ============ БЕТЕЙЛЬГЕЙЗЕ ============
const noiseFunctions = `
  vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
  vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }
  vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
  float snoise(vec3 v) {
    const vec2 C = vec2(1.0/6.0, 1.0/3.0);
    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
    vec3 i  = floor(v + dot(v, C.yyy));
    vec3 x0 = v - i + dot(i, C.xxx);
    vec3 g = step(x0.yzx, x0.xyz);
    vec3 l = 1.0 - g;
    vec3 i1 = min(g.xyz, l.zxy);
    vec3 i2 = max(g.xyz, l.zxy);
    vec3 x1 = x0 - i1 + C.xxx;
    vec3 x2 = x0 - i2 + C.yyy;
    vec3 x3 = x0 - D.yyy;
    i = mod289(i);
    vec4 p = permute(permute(permute(
              i.z + vec4(0.0, i1.z, i2.z, 1.0))
            + i.y + vec4(0.0, i1.y, i2.y, 1.0))
            + i.x + vec4(0.0, i1.x, i2.x, 1.0));
    float n_ = 0.142857142857;
    vec3 ns = n_ * D.wyz - D.xzx;
    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
    vec4 x_ = floor(j * ns.z);
    vec4 y_ = floor(j - 7.0 * x_);
    vec4 x = x_ * ns.x + ns.yyyy;
    vec4 y = y_ * ns.x + ns.yyyy;
    vec4 h = 1.0 - abs(x) - abs(y);
    vec4 b0 = vec4(x.xy, y.xy);
    vec4 b1 = vec4(x.zw, y.zw);
    vec4 s0 = floor(b0)*2.0 + 1.0;
    vec4 s1 = floor(b1)*2.0 + 1.0;
    vec4 sh = -step(h, vec4(0.0));
    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;
    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;
    vec3 p0 = vec3(a0.xy, h.x);
    vec3 p1 = vec3(a0.zw, h.y);
    vec3 p2 = vec3(a1.xy, h.z);
    vec3 p3 = vec3(a1.zw, h.w);
    vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2,p2), dot(p3,p3)));
    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
    vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m*m, vec4(dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3)));
  }
`;

const betelgeuseVertexShader = `
  uniform float time;
  varying vec3 vNormal;
  varying vec3 vPosition;
  varying vec2 vUv;
  varying float vDisplacement;
  ${noiseFunctions}
  void main() {
    vUv = uv;
    vNormal = normalize(normalMatrix * normal);
    vec3 pos = position;
    pos.y *= 0.92;
    pos.x *= 1.02;
    float convective = snoise(pos * 2.5 + time * 0.05) * 0.08;
    convective += snoise(pos * 5.0 - time * 0.08) * 0.04;
    float spot = smoothstep(0.7, 1.0, snoise(pos * 1.5 + vec3(0.0, time * 0.02, 0.0)));
    float spotDepth = spot * 0.06;
    float displacement = convective - spotDepth;
    vDisplacement = displacement;
    pos += normal * displacement;
    vPosition = pos;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
  }
`;

const betelgeuseFragmentShader = `
  uniform float time;
  varying vec3 vNormal;
  varying vec3 vPosition;
  varying vec2 vUv;
  varying float vDisplacement;
  ${noiseFunctions}
  void main() {
    float n1 = snoise(vPosition * 3.0 + time * 0.05);
    float n2 = snoise(vPosition * 6.0 - time * 0.08);
    float n3 = snoise(vPosition * 12.0 + time * 0.12);
    float n4 = snoise(vPosition * 20.0 - time * 0.15);
    float pattern = n1 * 0.5 + n2 * 0.3 + n3 * 0.15 + n4 * 0.05;
    float spot = smoothstep(0.5, 0.9, snoise(vPosition * 1.5 + vec3(0.0, time * 0.02, 0.0)));
    vec3 hotColor = vec3(1.0, 0.75, 0.35);
    vec3 warmColor = vec3(1.0, 0.45, 0.15);
    vec3 coolColor = vec3(0.7, 0.15, 0.05);
    vec3 darkColor = vec3(0.3, 0.05, 0.02);
    vec3 color = mix(warmColor, hotColor, smoothstep(-0.3, 0.5, pattern));
    color = mix(color, coolColor, smoothstep(0.2, 0.8, -pattern));
    color = mix(color, darkColor, spot * 0.7);
    float fresnel = pow(1.0 - abs(dot(vNormal, vec3(0.0, 0.0, 1.0))), 1.5);
    color = mix(color, coolColor * 0.6, fresnel * 0.5);
    float brightness = 1.0 + vDisplacement * 3.0;
    color *= brightness;
    float pulse = 0.95 + 0.05 * sin(time * 0.5);
    color *= pulse;
    gl_FragColor = vec4(color, 1.0);
  }
`;

const betelgeuseMaterial = new THREE.ShaderMaterial({
  uniforms: { time: { value: 0 } },
  vertexShader: betelgeuseVertexShader,
  fragmentShader: betelgeuseFragmentShader
});

const betelgeuseGeometry = new THREE.SphereGeometry(1.2, 128, 128);
const betelgeuse = new THREE.Mesh(betelgeuseGeometry, betelgeuseMaterial);
scene.add(betelgeuse);

// ============ СВЕЧЕНИЕ ============
const glowVertexShader = `
  varying vec3 vNormal;
  varying vec3 vPositionW;
  void main() {
    vNormal = normalize(normalMatrix * normal);
    vPositionW = (modelViewMatrix * vec4(position, 1.0)).xyz;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;

const glowMaterial = new THREE.ShaderMaterial({
  uniforms: { time: { value: 0 } },
  vertexShader: glowVertexShader,
  fragmentShader: `
    uniform float time;
    varying vec3 vNormal;
    varying vec3 vPositionW;
    void main() {
      vec3 viewDir = normalize(-vPositionW);
      float intensity = pow(0.7 - dot(vNormal, viewDir), 3.0);
      vec3 glowColor = vec3(1.0, 0.4, 0.15);
      float pulse = 0.9 + 0.1 * sin(time * 0.8);
      gl_FragColor = vec4(glowColor * intensity * pulse * 1.5, intensity * 0.8);
    }
  `,
  side: THREE.BackSide,
  blending: THREE.AdditiveBlending,
  transparent: true
});

const glow = new THREE.Mesh(new THREE.SphereGeometry(1.8, 64, 64), glowMaterial);
scene.add(glow);

const outerGlowMaterial = new THREE.ShaderMaterial({
  uniforms: { time: { value: 0 } },
  vertexShader: glowVertexShader,
  fragmentShader: `
    uniform float time;
    varying vec3 vNormal;
    varying vec3 vPositionW;
    void main() {
      vec3 viewDir = normalize(-vPositionW);
      float intensity = pow(0.5 - dot(vNormal, viewDir), 2.5);
      vec3 glowColor = vec3(1.0, 0.3, 0.1);
      gl_FragColor = vec4(glowColor * intensity * 0.6, intensity * 0.4);
    }
  `,
  side: THREE.BackSide,
  blending: THREE.AdditiveBlending,
  transparent: true
});
const outerGlow = new THREE.Mesh(new THREE.SphereGeometry(2.5, 64, 64), outerGlowMaterial);
scene.add(outerGlow);

// ============ ЧАСТИЦЫ ПЫЛИ ============
const dustGeometry = new THREE.BufferGeometry();
const dustCount = window.innerWidth < 768 ? 400 : 800;
const dustPositions = new Float32Array(dustCount * 3);
const dustVelocities = [];
for (let i = 0; i < dustCount; i++) {
  const theta = Math.random() * Math.PI * 2;
  const phi = Math.acos(2 * Math.random() - 1);
  const r = 1.4 + Math.random() * 2.5;
  dustPositions[i*3]   = r * Math.sin(phi) * Math.cos(theta);
  dustPositions[i*3+1] = r * Math.sin(phi) * Math.sin(theta) * 0.9;
  dustPositions[i*3+2] = r * Math.cos(phi);
  dustVelocities.push({
    speed: 0.002 + Math.random() * 0.005,
    theta: theta,
    phi: phi,
    r: r
  });
}
dustGeometry.setAttribute('position', new THREE.BufferAttribute(dustPositions, 3));

const dustMaterial = new THREE.ShaderMaterial({
  uniforms: { time: { value: 0 } },
  vertexShader: `
    uniform float time;
    attribute vec3 position;
    void main() {
      vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
      gl_PointSize = 3.0 * (100.0 / -mvPosition.z);
      gl_Position = projectionMatrix * mvPosition;
    }
  `,
  fragmentShader: `
    void main() {
      float d = length(gl_PointCoord - vec2(0.5));
      if (d > 0.5) discard;
      float alpha = smoothstep(0.5, 0.0, d) * 0.4;
      gl_FragColor = vec4(1.0, 0.5, 0.2, alpha);
    }
  `,
  transparent: true,
  depthWrite: false,
  blending: THREE.AdditiveBlending
});
const dust = new THREE.Points(dustGeometry, dustMaterial);
scene.add(dust);

// ============ УПРАВЛЕНИЕ КАМЕРОЙ (мышь + тач) ============
let targetCamX = 0, targetCamY = 0;
let currentCamX = 0, currentCamY = 0;
let isDragging = false;
let dragStartX = 0, dragStartY = 0;
let dragOffsetX = 0, dragOffsetY = 0;
let starRotY = 0, starRotX = 0;

// Мышь (десктоп)
document.addEventListener('mousemove', (e) => {
  if (!isDragging) {
    targetCamX = (e.clientX / window.innerWidth - 0.5) * 0.5;
    targetCamY = (e.clientY / window.innerHeight - 0.5) * 0.3;
  }
});

// ============ TOUCH-УПРАВЛЕНИЕ ============
let touchStartX = 0, touchStartY = 0;
let touchStartTime = 0;
let touchMoved = false;
let isTouchOnStar = false;
let lastTouchX = 0, lastTouchY = 0;

document.addEventListener('touchstart', (e) => {
  if (e.target.closest('.nav') || e.target.closest('.dot')) return;
  
  const touch = e.touches[0];
  touchStartX = touch.clientX;
  touchStartY = touch.clientY;
  lastTouchX = touch.clientX;
  lastTouchY = touch.clientY;
  touchStartTime = Date.now();
  touchMoved = false;
  
  // Проверяем, начался ли тап в центре (где звезда)
  const centerX = window.innerWidth / 2;
  const centerY = window.innerHeight / 2;
  const distFromCenter = Math.hypot(touch.clientX - centerX, touch.clientY - centerY);
  isTouchOnStar = distFromCenter < Math.min(window.innerWidth, window.innerHeight) * 0.35;
  
  if (isTouchOnStar) {
    isDragging = true;
    dragStartX = touch.clientX;
    dragStartY = touch.clientY;
  }
}, { passive: true });

document.addEventListener('touchmove', (e) => {
  if (e.target.closest('.nav')) return;
  
  const touch = e.touches[0];
  const dx = touch.clientX - touchStartX;
  const dy = touch.clientY - touchStartY;
  
  if (Math.abs(dx) > 10 || Math.abs(dy) > 10) {
    touchMoved = true;
  }
  
  if (isDragging && isTouchOnStar) {
    // Вращение звезды при drag в центре
    const moveX = touch.clientX - lastTouchX;
    const moveY = touch.clientY - lastTouchY;
    starRotY += moveX * 0.005;
    starRotX += moveY * 0.005;
    lastTouchX = touch.clientX;
    lastTouchY = touch.clientY;
    e.preventDefault();
  } else if (!isTouchOnStar) {
    // Подготовка к свайпу для слайдов
    targetCamX = (touch.clientX / window.innerWidth - 0.5) * 0.5;
    targetCamY = (touch.clientY / window.innerHeight - 0.5) * 0.3;
  }
}, { passive: false });

document.addEventListener('touchend', (e) => {
  if (e.target.closest('.nav')) return;
  
  const touch = e.changedTouches[0];
  const dx = touch.clientX - touchStartX;
  const dy = touch.clientY - touchStartY;
  const dt = Date.now() - touchStartTime;
  
  isDragging = false;
  
  // Определяем свайп
  const absDx = Math.abs(dx);
  const absDy = Math.abs(dy);
  const swipeThreshold = 50;
  const maxTime = 500;
  
  if (touchMoved && absDx > absDy && absDx > swipeThreshold && dt < maxTime) {
    // Горизонтальный свайп — переключаем слайды
    if (dx > 0) {
      prevSlide();
    } else {
      nextSlide();
    }
  } else if (!touchMoved && dt < 300) {
    // Короткий тап в центре — переключение на следующий слайд
    if (isTouchOnStar) {
      nextSlide();
    }
  }
  
  isTouchOnStar = false;
}, { passive: true });

// Предотвращение зума двойным тапом
let lastTouchEndTime = 0;
document.addEventListener('touchend', (e) => {
  const now = Date.now();
  if (now - lastTouchEndTime < 300) {
    e.preventDefault();
  }
  lastTouchEndTime = now;
}, { passive: false });

// ============ АНИМАЦИЯ ============
let time = 0;
function animate() {
  requestAnimationFrame(animate);
  time += 0.016;
  
  betelgeuseMaterial.uniforms.time.value = time;
  glowMaterial.uniforms.time.value = time;
  outerGlowMaterial.uniforms.time.value = time;
  dustMaterial.uniforms.time.value = time;
  starsMaterial.uniforms.time.value = time;
  
  // Плавное следование камеры
  currentCamX += (targetCamX - currentCamX) * 0.05;
  currentCamY += (targetCamY - currentCamY) * 0.05;
  camera.position.x = currentCamX * 2;
  camera.position.y = -currentCamY * 1.5;
  camera.lookAt(0, 0, 0);
  
  // Вращение звезды (автоматическое + от drag)
  betelgeuse.rotation.y += 0.001;
  betelgeuse.rotation.y += (starRotY - betelgeuse.rotation.y) * 0.02;
  betelgeuse.rotation.x += (starRotX - betelgeuse.rotation.x) * 0.02;
  
  // Постепенное затухание drag-вращения
  starRotY *= 0.99;
  starRotX *= 0.99;
  
  glow.rotation.y += 0.0008;
  dust.rotation.y += 0.0005;
  stars.rotation.y += 0.00005;
  
  // Анимация частиц пыли
  const positions = dust.geometry.attributes.position.array;
  for (let i = 0; i < dustCount; i++) {
    const v = dustVelocities[i];
    v.r += v.speed * 0.1;
    if (v.r > 4) v.r = 1.4;
    positions[i*3]   = v.r * Math.sin(v.phi) * Math.cos(v.theta + time * 0.05);
    positions[i*3+1] = v.r * Math.sin(v.phi) * Math.sin(v.theta + time * 0.05) * 0.9;
    positions[i*3+2] = v.r * Math.cos(v.phi);
  }
  dust.geometry.attributes.position.needsUpdate = true;
  
  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
});

// Предотвращение скролла и зума на iOS
document.addEventListener('gesturestart', (e) => e.preventDefault());
document.addEventListener('dblclick', (e) => e.preventDefault());

// ============ НАВИГАЦИЯ ============
const slides = document.querySelectorAll('.slide');
const totalSlides = slides.length;
let currentSlide = 0;

document.getElementById('total').textContent = String(totalSlides).padStart(2, '0');

const dotsContainer = document.getElementById('dots');
for (let i = 0; i < totalSlides; i++) {
  const dot = document.createElement('div');
  dot.className = 'dot' + (i === 0 ? ' active' : '');
  dot.onclick = () => goToSlide(i);
  dotsContainer.appendChild(dot);
}

function updateSlide() {
  slides.forEach((s, i) => s.classList.toggle('active', i === currentSlide));
  document.querySelectorAll('.dot').forEach((d, i) => d.classList.toggle('active', i === currentSlide));
  document.getElementById('current').textContent = String(currentSlide + 1).padStart(2, '0');
  
  // Вибрация на мобильных (если поддерживается)
  if ('vibrate' in navigator && window.innerWidth < 768) {
    navigator.vibrate(15);
  }
}

function nextSlide() {
  currentSlide = (currentSlide + 1) % totalSlides;
  updateSlide();
}
function prevSlide() {
  currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
  updateSlide();
}
function goToSlide(i) {
  currentSlide = i;
  updateSlide();
}

document.getElementById('prevBtn').addEventListener('click', prevSlide);
document.getElementById('nextBtn').addEventListener('click', nextSlide);

document.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowRight' || e.key === ' ') nextSlide();
  if (e.key === 'ArrowLeft') prevSlide();
});

// Скрываем подсказку после первого свайпа
let hintHidden = false;
document.addEventListener('touchstart', () => {
  if (!hintHidden) {
    const hint = document.getElementById('swipeHint');
    if (hint) hint.style.display = 'none';
    hintHidden = true;
  }
}, { once: true });
</script>

</body>
</html>
